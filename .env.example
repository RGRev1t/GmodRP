# Токен бота из https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=вставьте_токен_сюда

# ID сервера (правый клик по серверу -> Копировать ID, нужен режим разработчика).
# Можно указать несколько серверов сразу: GUILD_IDS=111,222 — команды появятся на обоих.
GUILD_ID=0
# GUILD_IDS=111111111111111111,222222222222222222

# ID владельцев бота через запятую (необязательно, у них полный доступ)
OWNER_IDS=

# Имя бота в сообщениях
BOT_NAME=GmodRP

# Стиль по умолчанию: compact или color
DEFAULT_STYLE=color

# Смещение часового пояса от UTC (МСК = 3)
TIMEZONE_OFFSET=3

# Сколько варнов считается пределом (1-10, меняется командой /лимит)
WARN_LIMIT=3

# Названия ролей на сервере: граница администрации и роль после снятия.
# Бот не создаёт шаблонов — берёт те роли, которые уже есть на сервере.
HELPER_ROLE_NAME=Хелпер
PLAYER_ROLE_NAME=Игрок

# Путь к базе (относительно папки бота)
DB_PATH=data/audit.db

# Путь к файлу лога
LOG_PATH=bot.log
